# CareScope Intrasite production / FDE package
# Copy to `.env` and replace every CHANGE_ME value before first boot.

# --- Image / publish ---
CARESCOPE_IMAGE_TAG=latest
INTRASITE_PORT=8080

# --- PostgreSQL control plane ---
POSTGRES_USER=carescope
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=intrasite

# Isolated tenant databases are created on the same Postgres server:
#   cs_<client_slug>
# The database user must be allowed to CREATE DATABASE.

# --- Intrasite auth (custom JWT) ---
INTRASITE_STORE=postgres
INTRASITE_JWT_SECRET=CHANGE_ME_JWT_SECRET_AT_LEAST_32_CHARS
INTRASITE_JWT_EXPIRES_IN=12h
INTRASITE_COOKIE_NAME=intrasite_token
INTRASITE_COOKIE_SECURE=false
INTRASITE_TRUST_PROXY=true
INTRASITE_CORS_ORIGIN=

# Bootstrap platform admin. Change after first login.
INTRASITE_ADMIN_EMAIL=admin@carescope.local
INTRASITE_ADMIN_PASSWORD=password
INTRASITE_ADMIN_NAME=Intrasite Admin
INTRASITE_SEED_DEMO=true

# --- Instance routing ---
INTRASITE_TENANT_HEADER=x-tenant-id
INTRASITE_LAB_HEADER=x-lab-id
INTRASITE_INSTANCE_HOST_PATTERN={slug}.intrasite.local

# --- Workflow API defaults ---
CARESCOPE_TENANT_ID=demo-lab
CARESCOPE_SYSTEM_USER=system
