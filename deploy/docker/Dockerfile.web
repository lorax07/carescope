# syntax=docker/dockerfile:1

FROM node:22-bookworm-slim AS build
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/workflow-core/package.json packages/workflow-core/
COPY packages/workflow-api/package.json packages/workflow-api/
COPY apps/designer/package.json apps/designer/
RUN pnpm install --frozen-lockfile
COPY packages/workflow-core packages/workflow-core
COPY apps/designer apps/designer
RUN pnpm --filter @carescope/designer build

FROM nginx:1.27-alpine
COPY deploy/nginx/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/designer/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=20s --timeout=5s --start-period=10s --retries=5 \
  CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1
