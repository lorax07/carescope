# syntax=docker/dockerfile:1

FROM node:22-bookworm-slim AS base
WORKDIR /app
RUN corepack enable

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/workflow-core/package.json packages/workflow-core/
COPY packages/workflow-api/package.json packages/workflow-api/
COPY apps/designer/package.json apps/designer/
RUN pnpm install --frozen-lockfile

FROM deps AS build
COPY packages/workflow-core packages/workflow-core
COPY packages/workflow-api packages/workflow-api
RUN pnpm --filter @carescope/workflow-core build \
  && pnpm --filter @carescope/workflow-api build \
  && pnpm --filter @carescope/workflow-api deploy --prod /out

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
RUN useradd --system --uid 10001 carescope
COPY --from=build --chown=carescope:carescope /out ./
USER carescope
EXPOSE 4000
HEALTHCHECK --interval=20s --timeout=5s --start-period=20s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:4000/api/v1/intrasite/health').then((r)=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "dist/server.js"]
